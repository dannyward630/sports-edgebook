# Copy to .env.local to point local dev at another Supabase project.
# Values come from Supabase: Project Settings > API Keys.
# The publishable key is public by design; access is protected by Row Level Security.
# Never put a secret key (sb_secret_...) or the legacy service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
